PORT=3001
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-32chars
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-32ch
DB_LOGGING=false
SEED_OWNER_EMAIL=owner@taskboard.local
SEED_OWNER_PASSWORD=OwnerPass123!
SEED_MANAGER_EMAIL=manager@taskboard.local
SEED_MANAGER_PASSWORD=ManagerPass123!
